# ==============================================================================
# TaskFlow Backend Environment Variables (TEMPLATE ONLY - NEVER COMMIT SECRETS)
# Copy to .env for LOCAL DEVELOPMENT. The dev profile imports .env automatically.
# The prod profile NEVER imports .env; set all production variables explicitly.
# ==============================================================================

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Database Configuration (Local MySQL for dev / Aiven for MySQL for prod)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=taskflow
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD
# Use PREFERRED or DISABLED locally; production requires REQUIRED or VERIFY_CA.
# .env is NOT loaded by the prod profile, so local PREFERRED cannot leak to prod.
DB_SSL_MODE=PREFERRED

# JWT Configuration (Generate >= 256-bit Base64 secret: openssl rand -base64 48)
JWT_SECRET=REPLACE_WITH_AT_LEAST_256_BIT_BASE64_ENCODED_SECRET_KEY_HERE
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=Lax

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Initial Admin Bootstrap (Created once on empty users table if configured)
BOOTSTRAP_ADMIN_EMAIL=admin@taskflow.local
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
BOOTSTRAP_ADMIN_NAME=System Administrator

# Development-only sample employees (EMP-0002 .. EMP-0006).
# Seeding is skipped when DEV_SEED_PASSWORD is empty.
DEV_SEED_ENABLED=true
DEV_SEED_PASSWORD=CHANGE_ME_DEV_SEED_PASSWORD

# File Storage Abstraction (local for dev, s3 for prod)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_MAX_FILE_SIZE_BYTES=10485760

# Reporting resource limits (env-overridable; defaults match application.yml).
# Bounds: buckets 1-500, rows 1-100000, KPIs 1-200, PDF pages 1-200.
REPORT_MAX_BUCKETS=120
REPORT_MAX_ROWS=20000
REPORT_MAX_KPIS=50
REPORT_MAX_PDF_PAGES=50

# Public auth/registration rate limits (env-overridable; defaults match application.yml).
# The in-process store is per instance; multi-instance deployments need a shared store.
RATE_LIMIT_LOGIN_PER_IP=100
RATE_LIMIT_LOGIN_FAILURES_PER_ACCOUNT=5
RATE_LIMIT_REFRESH_PER_IP=100
RATE_LIMIT_ACTIVATION_PER_IP=50
RATE_LIMIT_REGISTRATION_PER_IP=50
RATE_LIMIT_WINDOW_SECONDS=300
