# TaskFlow Backend REST API Base URL (no trailing slash)
# Development: copy to .env.local. If omitted, apiClient falls back to
# http://localhost:8080/api/v1 for the local dev server.
# Production: VITE_API_BASE_URL is REQUIRED and must be an absolute http(s) URL.
# `npm run build` fails with a clear error when it is missing or invalid.
VITE_API_BASE_URL=http://localhost:8080/api/v1
